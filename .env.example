# Server-only site origin for canonicals, sitemap, JSON-LD. No www.
# Do not use NEXT_PUBLIC_ — that exposes the value to the browser and locks editing on Vercel.
SITE_ORIGIN=https://zond.agency

NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Telegram — shared by site leads and Meta Lead Ads. Never commit real values.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional: forum topic thread in the target chat
TELEGRAM_MESSAGE_THREAD_ID=
TELEGRAM_SEND_TIMEOUT_MS=15000

# Meta Lead Ads webhook → Graph → Telegram (same bot/chat as site leads)
# Page: Zond Agency 101669778370346 · Ad account: 349069052926191
META_PAGE_ACCESS_TOKEN=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
# Set after the agreed form is published (draft: ZOND | Послуги | UA | 20.10.2026)
META_LEAD_FORM_ID=
# Comma-separated form IDs used only for Meta testing tool / drafts
META_LEAD_TEST_FORM_IDS=
META_GRAPH_API_VERSION=v22.0
# Optional persistent store path for leadgen_id dedupe (default: data/meta-leads)
META_LEADS_STORE_DIR=
META_LEAD_MAX_ATTEMPTS=3
META_LEAD_PROCESSING_LOCK_MS=120000
