# Server-only site origin for canonicals, sitemap, JSON-LD. No www.
# Do not use NEXT_PUBLIC_ — that exposes the value to the browser and locks editing on Vercel.
SITE_URL=https://zond.agency
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Server-only. Set in .env.local and in Vercel → Settings → Environment Variables.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
